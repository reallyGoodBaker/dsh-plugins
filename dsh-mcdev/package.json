{
  "name": "@local/dsh-mcdev",
  "version": "0.10.2",
  "private": true,
  "type": "module",
  "description": "NetEase Minecraft (网易我的世界) development companion: launch the ModPC dev client from DSH with the plugin own launcher, follow the official game log, talk to an in-game bridge pack, search the bundled NetEase ModSDK documentation, and assist mod development.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "lib/**/*.js",
    "docs/corpus/**",
    "docs/index.json",
    "docs/*.md",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  }
}
